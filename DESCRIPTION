Package: BrainNetTest
Type: Package
Title: Hypothesis Testing for Populations of Brain Networks
Version: 0.1.0
Authors@R: c(
    person("Maximiliano", "Martino",
           email = "maxii.martino@gmail.com",
           role  = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-2437-4387")),
