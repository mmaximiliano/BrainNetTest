\usepackage{amsmath,amssymb,booktabs}
\usepackage[section]{placeins}
\newcommand{\class}[1]{\code{#1}}

\author{
  Maximiliano Martino\\Universidad de San Andr\'es
  \And
  Daniel Fraiman\\Universidad de San Andr\'es and CONICET
}
\Plainauthor{Maximiliano Martino, Daniel Fraiman}

\title{\pkg{BrainNetTest}: Global and Edge-Wise Inference for Binary
  Brain Network Populations in \proglang{R}}
\Plaintitle{BrainNetTest: Global and Edge-Wise Inference for Binary Brain
  Network Populations in R}
\Shorttitle{\pkg{BrainNetTest}: Inference for Brain Network Populations}

\Abstract{
Clinical connectomics often compares one binary brain network per participant
and asks both whether diagnostic groups differ globally and which connections
carry the difference. We present \pkg{BrainNetTest}~1.0.0, an \proglang{R}
package for populations of aligned, binary, undirected brain networks. A
validated S3 input class enforces the brain-network analysis contract, and a
classed result supplies standard \code{print()}, \code{summary()},
\code{plot()}, and \code{as.data.frame()} methods. The global procedure is a
finite-sample label-randomization test based on the edge-separable $L_1$
analysis-of-variance score of Fraiman and Fraiman. Separate edge-wise Fisher
tests use Holm family-wise error control by default. The implementation
includes chunked matrix computation and prefix-sum updates for an optional
descriptive ablation path. In prespecified simulations, the largest observed
complete-null global rejection rate was \MaxGlobalNullRate{} and the largest
Holm family-wise error rate was \MaxHolmNullFWER{}. Across four alternatives,
mean Holm true-positive rate and precision were \MeanHolmTPR{} and
\MeanHolmPrecision{}. In a real ABIDE resting-state fMRI application, the
observed global statistic is extreme under autism-control label randomization
in the full cohort and in a covariate-balanced sensitivity sample, while no
single edge survives strict multiplicity control. The package source, tests,
clinical application, and standalone replication scripts are distributed
together.
}

\Keywords{\proglang{R}, brain connectomics, resting-state fMRI,
  randomization test, edge-wise inference, clinical group comparison}
\Plainkeywords{R, brain connectomics, resting-state fMRI, randomization test,
  edge-wise inference, clinical group comparison}

